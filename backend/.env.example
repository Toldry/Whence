# Which fare provider to use: "mock" (default, no token needed) or "travelpayouts".
FARE_PROVIDER=mock
# Travelpayouts API token (https://www.travelpayouts.com/programs/100/tools/api).
TRAVELPAYOUTS_API_TOKEN=
# Optional affiliate marker, appended to "Check live price" links.
TRAVELPAYOUTS_MARKER=
# Comma-separated Aviasales markets to query and merge, or "auto" (destination country).
TRAVELPAYOUTS_MARKETS=auto
# Pages of 1000 results to read per endpoint (each page is one API call).
TRAVELPAYOUTS_MAX_PAGES=2
PORT=8787
# Comma-separated browser origins allowed by CORS ("*" allows any).
CORS_ORIGINS=*
# How long a search result stays fresh in the cache, in minutes.
CACHE_TTL_MINUTES=30
# How long an expired result may still be served if the upstream is down, in hours.
CACHE_STALE_HOURS=24
CACHE_MAX_ENTRIES=500
